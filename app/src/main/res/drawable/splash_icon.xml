<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon canvas is 240dp (with an icon background); the visible circle is 160dp, so the
     2.55:1 logo is kept at 128dp wide to sit fully inside it. The logo is a 209px bitmap — a
     vector version would render sharper at this size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="128dp"
        android:height="50dp"
        android:gravity="center"
        android:drawable="@drawable/etims_logo" />
</layer-list>
