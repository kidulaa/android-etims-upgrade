<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prohibit cleartext HTTP traffic across the app for fiscal security -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- KRA eTIMS API Gateways Configuration -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">kra.go.ke</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
