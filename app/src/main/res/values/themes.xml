<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose owns all real theming (ui/theme/Theme.kt); this XML theme only covers the
         window background shown before the first Compose frame draws, and opts into
         edge-to-edge so the system bars don't force their own background/scrim. -->
    <style name="Theme.PayPoint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paypoint_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Light surfaces need dark system-bar icons (dark theme: light icons). The splash
             library re-applies these when it hands over, so they must be set here. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="29">shortEdges</item>
    </style>

    <!-- Launch theme (AndroidX SplashScreen, same look on API 26–36): the logo in a white circle
         on KRA red, held until the app knows which screen to open (see MainActivity). -->
    <style name="Theme.PayPoint.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/paypoint_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.PayPoint</item>
    </style>
</resources>
